PORT=4000
# Runtime connection. In production: the least-privilege role (beaconai_app), never the table owner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/beaconai
# Owner connection for schema changes, grants and policies. Leave unset in development.
MIGRATION_DATABASE_URL=
# The application role the grants and row-level security policy are written for.
APP_DB_ROLE=beaconai_app
API_BASE_URL=http://localhost:4000/api
WEB_BASE_URL=http://localhost:5173
# Two different secrets, each at least 32 characters in production.
# SESSION_SECRET signs sessions; TOKEN_ENCRYPTION_SECRET encrypts stored integration tokens.
SESSION_SECRET=replace_with_a_different_long_random_secret
TOKEN_ENCRYPTION_SECRET=replace_with_a_long_random_secret
# Only while rotating the token key: the old value, to read tokens not yet re-encrypted.
TOKEN_ENCRYPTION_SECRET_PREVIOUS=
# Founder operator token (at least 32 characters in production).
BEACONAI_ADMIN_TOKEN=

# Optional local fallback for a single test store. Production installs should use OAuth.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=shopify_oauth_client_id
SHOPIFY_CLIENT_SECRET=shopify_oauth_client_secret
SHOPIFY_SCOPES=read_products,read_customers,read_orders

# Optional local fallback for a single test Klaviyo account. Production installs should use OAuth.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_REVISION=2026-04-15
KLAVIYO_CLIENT_ID=klaviyo_oauth_client_id
KLAVIYO_CLIENT_SECRET=klaviyo_oauth_client_secret
KLAVIYO_SCOPES=accounts:read campaigns:read campaigns:write catalogs:read flows:read lists:write profiles:read profiles:write segments:read templates:read templates:write
